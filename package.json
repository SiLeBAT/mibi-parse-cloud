{
  "name": "mibi-parse-cloud",
  "version": "1.5.1",
  "license": "MIT",
  "private": false,
  "type": "commonjs",
  "scripts": {
    "start": "npm run start:server && npm run start:dashboard",
    "tsc": "tsc",
    "build": "npm run tsc && npm run cp:view",
    "cp:view": "copyfiles ./src/**/views/**/* ./lib",
    "test": "jest --config=jest.config.js",
    "prebuild": "npm run clean",
    "clean": "npx rimraf lib/* dist/*",
    "lint": "npx eslint .",
    "lint:fix": "npm run lint -- --fix",
    "pretty": "prettier --write \"src/**/*.ts\"",
    "prepare": "(husky -v && husky install) || echo husky not installed"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "npm run pretty",
      "npm run lint"
    ]
  },
  "dependencies": {
    "config": "~4.4.1",
    "fast-csv": "^5.0.2",
    "fast-xml-parser": "^5.7.3",
    "fs-readfile-promise": "~3.0.1",
    "fuse.js": "6.6.2",
    "handlebars": "~4.7.9",
    "lodash": "^4.18.1",
    "logform": "^2.6.0",
    "mibi-parse-cloud": "file:",
    "moment": "~2.29.4",
    "node-cache": "^5.1.2",
    "nodemailer": "8.0.7",
    "parse": "^8.6.0",
    "pdfmake": "^0.2.9",
    "shallow-equal-object": "^1.1.1",
    "validate.js": "0.13.1",
    "winston": "^3.13.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.2/xlsx-0.20.2.tgz",
    "xlsx-populate": "~1.21.0",
    "yup": "^1.3.3"
  },
  "devDependencies": {
    "@types/config": "4.4.0",
    "@types/fs-readfile-promise": "3.0.4",
    "@types/jest": "^29.5.12",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "8.0.0",
    "@types/pdfmake": "^0.2.9",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "copyfiles": "~2.4.1",
    "eslint": "^8.57.1",
    "husky": "~7.0.4",
    "jest": "~29.0.0",
    "jest-stare": "~2.4.1",
    "lint-staged": "~12.4.3",
    "prettier": "2.6.2",
    "rimraf": "~3.0.2",
    "ts-jest": "^29.1.2",
    "typescript": "~5.9.0"
  },
  "mibiConfig": {
    "lastChange": "2019-04-16 11:25:17 +0200"
  }
